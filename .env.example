# BRAND GENIUS — environment
#
# The app runs with none of these set: projects live in memory and identities
# are generated deterministically. Fill them in for real accounts, persistence,
# and model-generated logo marks.

# --- Supabase: database, auth, and asset storage -----------------------------
# Project settings → API. The anon key is safe to expose; RLS is the boundary.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Anthropic: brand strategy, palette, typography, and logo marks ----------
# Server-side only. Never prefix this with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# --- Deployment --------------------------------------------------------------
# Used for auth email redirect links and OpenGraph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase service_role : enregistrement des paiements -------------------
# Project settings → API → service_role. SERVEUR UNIQUEMENT, jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- SasPay : paiement des abonnements (Mobile Money et carte) --------------
# app.saspay.me → Développeur. Clé sk_test_… pour tester, sk_live_… en production.
# SERVEUR UNIQUEMENT. Ne jamais la coller dans un message ou dans le code.
SASPAY_SECRET_KEY=
# Secret de signature affiché UNE SEULE FOIS à la création du webhook
# (URL : https://votre-site/api/saspay/webhook, événement transaction.success).
SASPAY_WEBHOOK_SECRET=
# Devise des paiements. XAF = franc CFA d'Afrique centrale (Cameroun).
SASPAY_CURRENCY=XAF
