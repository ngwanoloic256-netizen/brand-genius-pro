# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit real values
.env*
# ...but the template documents which variables exist and holds no secrets.
!.env.example

# Secrets live outside this repository, in "C:\Users\pc\MCP X API KEYS".
# These patterns are a second line of defence for the day a key file gets
# copied in here by accident — the kind of mistake that is only ever noticed
# after the push.
*.key
*.pfx
*.p12
.credentials.json
credentials.json
secrets.json
cles.env
*secret*
*SECRET*
**/MCP X API KEYS/
.mcp.json
mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated image sources — only the optimised output is committed
/public/mockups/raw-*.png
/public/ambience/raw-*.png
# The brand mockups arrive as 4-6 MB PNGs and are served as WebP. Keeping both
# put ~36 MB of dead weight in the repository before this rule existed.
/public/brand/mockups/*.png
/.preview
